      "source": [
        "msm_model = MaskedSensorModel(input_channels=6, reservoir_size=32, mask_ratio=0.15)\n",
        "\n",
        "msm_model = masked_pretrain(\n",
        "    msm_model, train_ds, device,\n",
        "    epochs=30, batch_size=128, lr=0.0003, mask_ratio=0.15\n",
        ")\n",
