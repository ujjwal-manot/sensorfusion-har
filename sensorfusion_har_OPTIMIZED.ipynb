    "    opset_version=13,\n",
    "    input_names=[\"input\"],\n",
    "    output_names=[\"output\"],\n",
    "    dynamic_axes=None,  # Static shape for ESP32\n",
    ")\n",
    "onnx_model = onnx.load(onnx_path)\n",
    "onnx.checker.check_model(onnx_model)\n",
    "onnx_size_kb = os.path.getsize(onnx_path) / 1024\n",
