    "            loss.backward()\n",
    "            torch.nn.utils.clip_grad_norm_([p for p in m.parameters() if p.requires_grad], 1.0)\n",
    "            opt2.step()\n",
    "        sch2.step()\n",
    "        m.eval()\n",
    "        correct, total = 0, 0\n",
    "        all_preds, all_labels = [], []\n",
    "        with torch.no_grad():\n",
    "            for xb, yb in opp_test_loader:\n",
    "                xb, yb = xb.to(device), yb.to(device)\n",
    "                preds = m(xb).argmax(1)\n",
