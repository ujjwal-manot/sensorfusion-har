    "esp32_model.eval()\n",
    "\n",
    "# --- Step 1: Export to ONNX (CPU for compatibility) ---\n",
    "esp32_model_cpu = esp32_model.cpu()\n",
    "esp32_model_cpu.eval()\n",
    "onnx_path = os.path.join(EXPORT_DIR, \"sensorfusion_lite.onnx\")\n",
