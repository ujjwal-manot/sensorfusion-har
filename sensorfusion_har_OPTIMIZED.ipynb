    "    print(f\"\\n{'='*40}\\nOPPORTUNITY {tag.upper()}\\n{'='*40}\")\n",
    "\n",
    "    m = SensorFusionHAR(input_channels=6, reservoir_size=32, num_classes=opp_num_classes).to(device)\n",
    "\n",
