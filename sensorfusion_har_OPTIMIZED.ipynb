        "print(f\"\\nForward pass test: input {dummy.shape} -> output {out.shape}\")\n",
        "print(f\"  Attention entropy:  {aux['attention_entropy'].item():.4f}\")\n",
        "print(f\"  Spectral radius:    {aux['spectral_radius'].item():.4f}\")\n",
